NODE_ENV=development
DATA_MODE=real
TARGET_SET=18
TARGET_GAME_MODE=standard
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>
TEST_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<test_database>
RAW_STORAGE_ROOT=./storage/raw
SOURCES_CONFIG_PATH=./config/sources.json
INGEST_ENABLED=false
INGEST_INTERVAL_MINUTES=120
FETCH_TIMEOUT_MS=60000
FETCH_MAX_BYTES=67108864
AUTO_PUBLISH=false
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000
# Required for live Elite ingestion. Replace locally; never commit either value.
RIOT_API_KEY=
ACCOUNT_KEY_HMAC_SECRET=
COMMUNITYDRAGON_VERSION=18.2
